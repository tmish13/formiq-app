# Project
PROJECT_NAME=FormIQ
VERSION=1.0.0
DESCRIPTION=AI-powered fitness tracking and form analysis
API_V1_STR=/api/v1
ENVIRONMENT=production
DEBUG=false

# CORS - Update with actual production domain
CORS_ORIGINS=["https://formiq-app.com", "https://www.formiq-app.com", "https://app.formiq-app.com"]

# Security - Use strong secret key in production
SECRET_KEY=${SECRET_KEY}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours instead of 8 days
REFRESH_TOKEN_EXPIRE_DAYS=14      # 14 days instead of 30
ADMIN_REGISTRATION_CODE=${ADMIN_CODE}

# Database - Update with production database settings
POSTGRES_SERVER=${POSTGRES_SERVER}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=${POSTGRES_DB}
SQLALCHEMY_DATABASE_URI=${SQLALCHEMY_DATABASE_URI}

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false

# Email
SMTP_TLS=True
SMTP_PORT=${SMTP_PORT}
SMTP_HOST=${SMTP_HOST}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
EMAILS_FROM_EMAIL=no-reply@formiq-app.com
EMAILS_FROM_NAME=FormIQ

# Stripe
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}

# AWS S3 Configuration for media storage
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=us-west-2
S3_BUCKET=${S3_BUCKET}
USE_S3_STORAGE=true

# Redis - Update with production Redis settings
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
USE_REDIS_CACHE=true

# Storage - Use S3 for production
UPLOAD_DIR=uploads/videos
UPLOAD_URL=your_s3_bucket_url
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes
MAX_VIDEO_DURATION=300        # 5 minutes in seconds

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_STDOUT=true
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/formiq/application.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5
ENABLE_REQUEST_LOGGING=true
ENABLE_SENTRY=true
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate limiting
RATE_LIMIT_STORAGE=redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100    # Default requests per minute
RATE_LIMIT_DEFAULT_BURST=200       # Default burst limit
RATE_LIMIT_TOKEN_REQUESTS=50       # Lower limit for token endpoints

# Security Headers
SECURITY_HSTS_SECONDS=31536000  # 1 year
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_FRAME_DENY=true
SECURITY_XSS_PROTECTION=true
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_CONTENT_SECURITY_POLICY="default-src 'self'; img-src 'self' data: https://*.s3.amazonaws.com; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://api.stripe.com;"

# Miscellaneous
APP_DOMAIN=formiq-app.com
ENABLE_DOCS=false 