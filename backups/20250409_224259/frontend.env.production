# API Configuration
REACT_APP_API_URL=${API_URL}
REACT_APP_WS_URL=${WS_URL}

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_REPORTING=true

# Authentication
REACT_APP_AUTH_DOMAIN=your-auth-domain
REACT_APP_AUTH_CLIENT_ID=your-client-id

# Video Processing
REACT_APP_MAX_VIDEO_SIZE=100000000 # 100MB in bytes
REACT_APP_ALLOWED_VIDEO_TYPES=mp4,webm,mov

# Cache Configuration
REACT_APP_CACHE_TTL=3600 # 1 hour in seconds

# Stripe Configuration
REACT_APP_STRIPE_PUBLIC_KEY=your_production_stripe_public_key
REACT_APP_DEBUG_MODE=false

# Sentry Configuration
REACT_APP_SENTRY_DSN=${SENTRY_DSN}

# PWA Settings
REACT_APP_ENABLE_INSTALL_PROMPT=true

# Third-party Services
REACT_APP_GA_TRACKING_ID=${GA_TRACKING_ID}

# Application Settings
REACT_APP_MAX_UPLOAD_SIZE=104857600
REACT_APP_SUPPORTED_FILE_TYPES=".pdf,.doc,.docx,.txt" 