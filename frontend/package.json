    "@capacitor/core": "^7.2.0",
    "@capacitor/device": "^7.0.1",
    "@capacitor/filesystem": "^7.0.1",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/network": "^7.0.1",
    "@capacitor/preferences": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^4.1.3",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.17.0",
    "@types/node": "^20.11.0",
    "@types/react-dom": "^18.2.0",
    "@types/redux-logger": "^3.0.13",
    "@types/redux-persist": "^4.3.1",
    "ajv": "^8.17.1",
    "antd": "^5.24.6",
    "axios": "^1.4.0",
    "chart.js": "^4.4.8",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.6.3",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "nth-check": "^2.1.1",
    "postcss": "^8.5.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.2",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "typescript": "^4.9.5",
    "wabt": "^1.0.32",
    "web-vitals": "^2.1.4",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/plugin-transform-object-rest-spread": "^7.25.9",
    "@faker-js/faker": "^9.7.0",
    "@reduxjs/toolkit": "^2.7.0",
    "@tanstack/react-query": "^5.74.3",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@types/styled-components": "^5.1.34",
    "babel-plugin-styled-components": "^2.1.4",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "msw": "^1.3.2",
    "node-fetch": "^2.7.0",
    "prettier": "^3.5.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.5.0",
    "react-scripts": "^5.0.1",
    "source-map-explorer": "^2.5.3",
    "styled-components": "^6.1.17",
    "ts-jest": "^29.3.0",
    "vitest": "^3.1.1",
    "web-streams-polyfill": "^4.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 npm run build:safe",
    "build:safe": "node scripts/build-wasm.js || true && node scripts/copy-wasm.js || true && react-scripts build",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:ci": "jest --config jest.config.js --coverage --ci",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:backstop": "backstop test --config=backstop.config.js",
    "test:backstop:approve": "backstop approve --config=backstop.config.js",
    "test:backstop:reference": "backstop reference --config=backstop.config.js",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync",
    "cap:android": "npx cap run android",
    "cap:ios": "npx cap run ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "ios:build": "cd ios && pod install && cd .. && npm run cap:ios",
    "ios:run": "cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 15' build run",
    "eject": "react-scripts eject",
    "build:wasm": "node scripts/build-wasm.js",
    "copy:wasm": "node scripts/copy-wasm.js",
    "postinstall": "npm run build:wasm",
    "theme:audit": "node scripts/theme-audit.js",
    "theme:fix": "node scripts/theme-audit.js --fix",
    "analyze": "source-map-explorer 'build/static/js/*.js'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
