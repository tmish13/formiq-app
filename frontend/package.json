    "jest": "^29.7.0",
    "jest-coverage-badges": "^1.1.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "msw": "^1.3.5",
    "node-fetch": "^2.7.0",
    "prettier": "^3.5.3",
    "react-scripts": "^5.0.1",
    "ts-jest": "^29.3.0",
    "web-streams-polyfill": "^4.1.0",
    "wabt": "^1.0.32"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run build:wasm && npm run copy:wasm && react-scripts build",
    "test": "react-scripts test --watchAll=false --transformIgnorePatterns \"node_modules/(?!@capacitor)/\" --setupFiles ./src/polyfills.js --setupFilesAfterEnv ./src/setupTests.ts",
    "test:coverage": "jest --coverage",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync",
    "cap:android": "npx cap run android",
    "cap:ios": "npx cap run ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "ios:build": "cd ios && pod install && cd .. && npm run cap:ios",
    "ios:run": "cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 15' build run",
    "eject": "react-scripts eject",
    "build:wasm": "node scripts/build-wasm.js",
    "copy:wasm": "node scripts/copy-wasm.js",
    "postinstall": "npm run build:wasm"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
