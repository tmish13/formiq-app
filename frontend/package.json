  "scripts": {
    "start": "react-app-rewired start",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 npm run build:safe",
    "build:safe": "node scripts/build-wasm.js || true && node scripts/copy-wasm.js || true && react-scripts build",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:ci": "jest --config jest.config.js --coverage --ci",
    "test:consolidated": "jest --config jest.config.js --testMatch=\"**/tests/consolidated/*.consolidated.test.(ts|tsx)\"",
    "test:coverage:consolidated": "jest --config jest.config.js --coverage --testMatch=\"**/tests/consolidated/*.consolidated.test.(ts|tsx)\"",
    "test:e2e": "cypress run",
    "test:integration": "jest --config jest.config.js --testMatch=\"**/tests/integration/**/*.test.(ts|tsx)\" --coverage=false",
    "test:integration:watch": "jest --config jest.config.js --testMatch=\"**/tests/integration/**/*.test.(ts|tsx)\" --watch --coverage=false",
    "test:e2e:open": "cypress open",
    "test:backstop": "backstop test --config=backstop.config.js",
    "test:backstop:approve": "backstop approve --config=backstop.config.js",
    "test:backstop:reference": "backstop reference --config=backstop.config.js",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync",
    "cap:android": "npx cap run android",
    "cap:ios": "npx cap run ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "ios:build": "cd ios && pod install && cd .. && npm run cap:ios",
    "ios:run": "cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug -destination 'platform=iOS Simulator,name=iPhone 15' build run",
    "eject": "react-scripts eject",
    "build:wasm": "node scripts/build-wasm.js",
    "copy:wasm": "node scripts/copy-wasm.js",
    "postinstall": "npm run build:wasm",
    "theme:audit": "node scripts/theme-audit.js",
    "theme:fix": "node scripts/theme-audit.js --fix",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "test:setup": "npm install --save-dev supertest @tensorflow/tfjs msw jest-environment-jsdom"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "statements": 85,
        "functions": 80,
        "branches": 75
      },
      "./src/services/!(**/__tests__/**)": {
        "lines": 90,
        "statements": 90,
        "functions": 90,
        "branches": 85
      }
    }
  },
  "resolutions": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
