{
  "type": "module",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js",
    "eject": "react-scripts eject",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --coverage",
    "test:e2e": "cypress run",
    "test:security": "npm audit && snyk test",
    "cap:sync": "npx cap sync && npm run fix:java",
    "cap:build": "npm run build && npx cap sync && npm run fix:java",
    "cap:android": "npm run fix:java && npx cap run android",
    "cap:ios": "npx cap run ios",
    "cap:open:android": "npm run fix:java && npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "fix:java": "node fix-java-version.js",
    "test:consolidated": "jest --testMatch=\"../tests/consolidated/**/*.consolidated.test.{ts,tsx}\" --testPathIgnorePatterns=\"/src/\" --roots=\"../tests/consolidated\"",
    "test:coverage:consolidated": "jest --coverage --collectCoverageFrom=\"src/**/*.{ts,tsx}\" --testMatch=\"../tests/consolidated/**/*.consolidated.test.{ts,tsx}\" --testPathIgnorePatterns=\"/src/\" --roots=\"../tests/consolidated\"",
    "test:coverage:report": "cd .. && node scripts/coverage-audit.sh"
  },
  "dependencies": {
    "@capacitor/camera": "^7.0.1",
    "@capacitor/filesystem": "^7.0.1",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/network": "^7.0.1",
    "@capacitor/preferences": "^7.0.1",
    "@mediapipe/pose": "^0.5.1675469404",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/styled-components": "^5.1.34",
    "google-auth-library": "^10.1.0",
    "react-feather": "^2.0.10",
    "react-router-dom": "^6.11.2",
    "styled-components": "^6.1.17"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.3",
    "node-fetch": "^3.3.2",
    "react-redux": "^9.2.0",
    "react-scripts": "^5.0.1",
    "text-encoding": "^0.7.0",
    "ts-jest": "^29.3.2",
    "ts-morph": "^25.0.1",
    "typescript": "^4.9.5",
    "undici": "^7.8.0",
    "util": "^0.12.5",
    "web-streams-polyfill": "^4.1.0"
  }
}
