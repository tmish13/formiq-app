# Project
PROJECT_NAME=FormIQ
VERSION=1.0.0
DESCRIPTION=AI-powered exercise form analysis API
API_V1_STR=/api/v1

# Server
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=24h
ALGORITHM=HS256
BCRYPT_ROUNDS=10

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formiq
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

########################################
# EMAIL CONFIGURATION
########################################
#
# IMPORTANT:
#   If MAIL_USERNAME, MAIL_PASSWORD, or MAIL_FROM_EMAIL contain placeholder values
#   (anything with "your_email", "your_app_password", etc.), the backend will detect
#   them automatically and disable email sending entirely — no SMTP connection will
#   be attempted. You MUST replace all three with real values.
#
#   After editing this file:
#     1. Restart the server (--reload does NOT re-read .env automatically):
#          uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
#     2. Verify with the test endpoint:
#          curl -s -X POST http://localhost:8000/api/v1/debug/email-test \
#            -H "Content-Type: application/json" \
#            -d '{"to": "your.real.email@gmail.com"}' | python -m json.tool
#        Expected: {"sent": true, "smtp_server": "...", "smtp_username": "...", "error": null}
#     3. If "sent": false, check the "error" field and backend logs for details.
#
# ── Option A: Gmail with App Password (easiest for local dev) ────────────────
#   Prerequisites:
#     1. Enable 2-Factor Authentication on your Google account.
#     2. Go to: myaccount.google.com → Security → App Passwords
#     3. Create an App Password for "Mail" → copy the 16-character code.
#   Do NOT use your normal Gmail login password — it will be rejected by Gmail.
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.actual.gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM_EMAIL=your.actual.gmail@gmail.com
MAIL_FROM_NAME=FormIQ
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=true
#
# ── Option B: Resend.com (recommended for beta/production) ───────────────────
#   Free tier: 3,000 emails/month, no credit card required.
#   Prerequisites:
#     1. Sign up free at resend.com.
#     2. Go to API Keys → Create Key → copy the key starting with re_
#     3. Optionally verify your own domain for a custom FROM address.
#        (If using onboarding@resend.dev, no domain verification needed.)
#
# MAIL_SERVER=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx      # your Resend API key
# MAIL_FROM_EMAIL=onboarding@resend.dev      # or your verified domain
# MAIL_FROM_NAME=FormIQ
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false
# MAIL_USE_CREDENTIALS=true
#
# ── Beta flag ─────────────────────────────────────────────────────────────────
# true  → unverified users can log in (amber in-app banner shown).
# false → login blocked until email verified (enforce once SMTP is confirmed working).
BETA_ALLOW_UNVERIFIED=true
# ─────────────────────────────────────────────────────────────────────────────

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Monitoring
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT=100
RATE_LIMIT_WINDOW=15m

# Storage
UPLOAD_DIR=uploads/videos
UPLOAD_URL=http://localhost:8000/uploads/videos

########################################
# AI COACHING FEEDBACK (RAG)
########################################
#
# RAG_ENABLED defaults to true but is a no-op until OPENAI_API_KEY is set.
# Once set, the analysis pipeline generates coaching paragraphs after each
# squat session and stores them in form_check.results["posture_v1"]["feedback_text"].
#
# Setup steps:
#   1. Set OPENAI_API_KEY to a real key.
#   2. Run:  python scripts/initialize_vector_store.py
#      to populate the Chroma vector store with biomechanical knowledge.
#   3. Restart the Celery worker (it does NOT auto-reload):
#      celery -A app.core.celery_app worker --loglevel=info
#
# Model choice: gpt-4o-mini is fast and cheap; gpt-4o for higher quality.
#
OPENAI_API_KEY=your_openai_api_key_here
RAG_ENABLED=true
RAG_MODEL_NAME=gpt-4o-mini
RAG_MAX_TOKENS=500
RAG_TEMPERATURE=0.7
RAG_TOP_K_RESULTS=3 