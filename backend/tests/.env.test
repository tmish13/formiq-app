# Test environment configuration
ENVIRONMENT="test"

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_db
TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"
# Add other test-specific environment variables here if needed
ASYNC_DATABASE_URL="sqlite+aiosqlite:///./test.db" # Also set this for consistency if Settings class prefers it
SQLALCHEMY_DATABASE_URI="sqlite:///./test.db" # For synchronous Alembic
DB_ECHO=true

# Security
SECRET_KEY=test_secret_key
JWT_SECRET=a_secure_32_char_long_jwt_secret_key_123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAIL_USERNAME="testuser"
MAIL_PASSWORD="testpassword"
MAIL_SERVER="testsmtpserver"
MAIL_PORT=587
# Ensure other necessary variables for testing are present
EMAIL_TEMPLATES_DIR="app/templates/email" # This should still work if CWD is backend

# Email
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=test.smtp.com
SMTP_USER=test_smtp_user
SMTP_PASSWORD=test_smtp_password
EMAILS_FROM_EMAIL=test@example.com
EMAILS_FROM_NAME=Test

# Stripe
STRIPE_SECRET_KEY=test_stripe_key
STRIPE_WEBHOOK_SECRET=test_webhook_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=DEBUG

# Monitoring
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=/tmp 